doctype html
html
  head
    title Login Paula - El Imperio
    style.
      body {
        background: radial-gradient(circle at center, #1a3a5f 0%, #001524 100%) no-repeat center center fixed;
        color: #e0f7fa;
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
      }
      .login-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        padding: 40px;
        border-radius: 25px;
        border: 2px solid #00d2ff;
        text-align: center;
        box-shadow: 0 0 30px rgba(0, 210, 255, 0.3);
        width: 320px;
      }
      h1 { 
        color: #00d2ff; 
        text-shadow: 0 0 15px #00d2ff; 
        margin-bottom: 25px; 
        font-size: 1.8em;
      }
      input {
        width: 100%;
        padding: 12px;
        margin: 15px 0;
        border-radius: 10px;
        border: 1px solid rgba(0, 210, 255, 0.5);
        background: rgba(0,0,0,0.4);
        color: white;
        text-align: center;
        font-size: 1.1em;
        box-sizing: border-box;
        outline: none;
      }
      input:focus {
        border-color: #fff;
        box-shadow: 0 0 10px rgba(255,255,255,0.2);
      }
      button {
        background: #00d2ff;
        color: #001524;
        border: none;
        padding: 12px;
        width: 100%;
        border-radius: 50px;
        font-weight: bold;
        cursor: pointer;
        font-size: 1em;
        transition: 0.3s;
        text-transform: uppercase;
        margin-top: 10px;
      }
      button:hover { 
        background: #fff; 
        box-shadow: 0 0 20px #00d2ff; 
        transform: scale(1.05);
      }
      .footer-p {
        margin-top: 20px;
        font-size: 0.7em;
        opacity: 0.5;
        letter-spacing: 1px;
      }

  body
    .login-card
      h1 🐧 🧊 ACCESO PAULA
      form(method="POST" action="/login")
        //- El nombre del input debe ser "password" para que Node/Go lo lea bien
        input(type="password" name="password" placeholder="Clave Secreta" required)
        button(type="submit") ENTRAR AL SISTEMA
      p.footer-p PROPIEDAD DEL IMPERIO PINGÜINO